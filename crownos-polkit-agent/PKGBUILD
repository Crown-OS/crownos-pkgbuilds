pkgname=crownos-polkit-agent
pkgver=0.1.0
pkgrel=1
pkgdesc="Polkit authentication agent for CrownOS"
arch=(x86_64)
url="https://github.com/Crown-OS/crownos-polkit-agent"
license=(MIT)
depends=(gcc-libs glibc libglvnd libxkbcommon fontconfig vulkan-icd-loader wayland polkit)
provides=(polkit-authentication-agent)
makedepends=(cargo git)
install=crownos-polkit-agent.install
source=("$pkgname::git+$url.git#tag=v$pkgver"
        "crownos-config::git+https://github.com/Crown-OS/crownos-config.git#commit=10da919cac672bb14fc8145fde321e50aaa90cf3"
        "crownos-protocols::git+https://github.com/Crown-OS/crownos-protocols.git#commit=d82bd26ea16fbdc5824f985a5fdca31ca14a7031"
        "crownui::git+https://github.com/Crown-OS/crownui.git#commit=2d397ae41772c5ebefc2199f5ebad8b2b1b8d788")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/crownos-polkit-agent target/release/crownos-polkit-dialog -t "$pkgdir/usr/bin"
  install -Dm644 data/crownos-polkit-agent.service -t "$pkgdir/usr/lib/systemd/user"
}

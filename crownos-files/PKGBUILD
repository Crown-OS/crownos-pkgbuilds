pkgname=crownos-files
pkgver=0.1.0
pkgrel=1
pkgdesc="File manager for CrownOS"
arch=(x86_64)
url="https://github.com/Crown-OS/crownos-files"
license=(MIT)
depends=(gcc-libs glibc libglvnd libxkbcommon fontconfig vulkan-icd-loader wayland
         libjpeg-turbo cairo poppler-glib gstreamer gst-plugins-base gst-plugins-good
         shared-mime-info udisks2 polkit xdg-utils)
optdepends=('gst-plugin-va: hardware-decoded video thumbnails'
            'crownos-polkit-agent: password prompts for drives and protected folders'
            'crownos-preview: quick look')
makedepends=(cargo git pkgconf)
source=("$pkgname::git+$url.git#tag=v$pkgver"
        "crownconnect-linux::git+https://github.com/Crown-OS/crownlink-linux.git#commit=1f98db9bee635514cf0d2030a4ddcc20b84fba92"
        "crownos-config::git+https://github.com/Crown-OS/crownos-config.git#commit=10da919cac672bb14fc8145fde321e50aaa90cf3"
        "crownos-ipc::git+https://github.com/Crown-OS/crownos-ipc.git#commit=1bdb5a681314e10d78876d11ad8362901eebd798"
        "crownos-preview::git+https://github.com/Crown-OS/crownos-preview.git#commit=e48d17542d3da34474007bac064715c334a113c5"
        "crownos-protocols::git+https://github.com/Crown-OS/crownos-protocols.git#commit=d82bd26ea16fbdc5824f985a5fdca31ca14a7031"
        "crownui::git+https://github.com/Crown-OS/crownui.git#commit=2d397ae41772c5ebefc2199f5ebad8b2b1b8d788")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p crownos-files -p crownos-files-helper
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/crownos-files -t "$pkgdir/usr/bin"
  install -Dm755 target/release/crownos-files-helper -t "$pkgdir/usr/lib/crownos-files"
  install -Dm644 crates/app/data/crownos-files.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 crates/helper/data/org.crownos.files.helper.policy -t "$pkgdir/usr/share/polkit-1/actions"
}
